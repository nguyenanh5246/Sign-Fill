<Window x:Class="Sign_Fill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SignFill"
        Width="750"
        Height="600"
        MinWidth="650"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- TITLE -->

        <TextBlock
            Grid.Row="0"
            Text="SignFill"
            FontSize="40"
            FontWeight="Bold"
            Margin="0,0,0,25" HorizontalAlignment="Center"/>


        <!-- INPUT -->

        <Grid Grid.Row="1"
      Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
        Grid.Column="0"
        Text="Input"
        FontWeight="Bold"
        VerticalAlignment="Center"
        FontSize="14"/>

            <StackPanel
        Grid.Column="1"
        Orientation="Horizontal"
        VerticalAlignment="Center">

                <TextBlock
            x:Name="InputStatusIcon"
            Text="?"
            FontSize="22"
            FontWeight="Bold"
            Margin="0,0,8,0"/>

                <TextBlock
            x:Name="InputStatusText"
            Text="Checking..."
            FontSize="14"
            VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>


        <!-- TEMPLATE -->

        <Grid Grid.Row="2"
      Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
        Grid.Column="0"
        Text="Template"
        FontWeight="Bold"
        VerticalAlignment="Center"
        FontSize="14"/>

            <StackPanel
        Grid.Column="1"
        Orientation="Horizontal"
        VerticalAlignment="Center">

                <TextBlock
            x:Name="TemplateStatusIcon"
            Text="?"
            FontSize="22"
            FontWeight="Bold"
            Margin="0,0,8,0"/>

                <TextBlock
            x:Name="TemplateStatusText"
            Text="Checking..."
            FontSize="14"
            VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>


        <!-- FILE NAME PATTERN -->

        <Grid Grid.Row="3"
              Margin="0,0,0,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Output filename pattern"
                FontWeight="Bold"
                Margin="0,0,0,8" FontSize="14"/>

            <TextBox
                Grid.Row="1"
                x:Name="FileNamePatternTextBox"
                Height="45"
                FontSize="14"
                Padding="10"
                Text="{}{HoTen}_{CCCD}_{ChucVu}"/>

        </Grid>


        <!-- AVAILABLE FIELDS -->

        <Grid Grid.Row="4"
              Margin="0,0,0,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Available Excel fields"
                FontWeight="Bold"
                Margin="0,0,0,8" FontSize="14"/>

            <ScrollViewer
                Grid.Row="1"
                MaxHeight="90"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <WrapPanel
                    x:Name="FieldPanel"/>

            </ScrollViewer>

        </Grid>


        <!-- GENERATE + STATUS -->

        <Grid Grid.Row="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <Button
                Grid.Row="0"
                x:Name="GenerateButton"
                Content="GENERATE"
                Width="180"
                Height="45"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Click="GenerateButton_Click" FontSize="24"/>


            <TextBlock
                Grid.Row="1"
                x:Name="StatusText"
                Text="Status: Ready"
                Margin="0,15,0,0"
                FontSize="14" HorizontalAlignment="Center"/>

        </Grid>


        <!-- FOOTER -->

        <Grid Grid.Row="6"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Tool created by Nguyen Duc Anh"
                VerticalAlignment="Bottom" FontSize="14"/>

            <TextBlock
                Grid.Column="1"
                Text="v1.1"
                VerticalAlignment="Bottom" FontSize="14"/>

        </Grid>

    </Grid>

</Window>